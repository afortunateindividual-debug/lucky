# PolyLingua AI — Environment Variables
# Copy this file to .env and adjust values for your environment

# Server port (default: 3001)
PORT=3001

# Node environment
NODE_ENV=production

# SQLite database file path (default: ./data.db)
# DB_PATH=./data.db

# Edge TTS Python path (leave empty on cloud — falls back to browser speech)
# TTS_PY=C:/Users/Administrator/.workbuddy/binaries/python/envs/default/Scripts/python.exe
TTS_PY=
