.detail-head { text-align:center; }
.detail-cover { font-size:72rpx; }
.detail-title { font-size:34rpx; font-weight:700; margin-top:10rpx; }
.detail-desc { font-size:26rpx; color:#666; margin-top:16rpx; line-height:1.5; text-align:left; }
.lesson { display:flex; align-items:flex-start; }
.lesson-no { width:48rpx; height:48rpx; line-height:48rpx; text-align:center; background:#4a7dff; color:#fff; border-radius:50%; font-size:24rpx; margin-right:20rpx; flex-shrink:0; }
.lesson-body { flex:1; }
.lesson-title { font-size:28rpx; font-weight:600; }
.lesson-sum { font-size:24rpx; color:#888; margin-top:6rpx; line-height:1.4; }
.footer-bar { position:fixed; left:0; right:0; bottom:0; padding:16rpx 28rpx; background:#fff; box-shadow:0 -2rpx 10rpx rgba(0,0,0,0.05); }
.footer-bar .btn-primary { margin:0; }
